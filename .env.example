# Grafito server environment. Compose supplies service hostnames automatically.
# Never expose these values through VITE_ variables.
# Omitted services use the local fallbacks documented below.

# Postgres for accounts, permissions and indexes; fallback: embedded PGLite.
DATABASE_URL=postgres://grafito:grafito@127.0.0.1:5432/grafito

# Elasticsearch note search; fallback: Postgres index.
ELASTICSEARCH_URL=http://127.0.0.1:9200

# MinIO/S3 requires all four settings; otherwise files use Postgres.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=grafito
S3_ACCESS_KEY=grafito
S3_SECRET_KEY=grafito-secret

# Bucket region, default us-east-1.
S3_REGION=us-east-1

# Redis session deadlines support live revocation; fallback: Postgres.
REDIS_URL=redis://127.0.0.1:6379

# Signs sessions, file links and Office tokens. Missing or public example values
# are replaced with installation secrets in GRAFITO_SECRETS_DIR; see docs/SECURITY.md.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://127.0.0.1:8080
# Other sites allowed to send sign-ins, comma-separated. Rarely needed: the
# address a request is sent to (the server's IP, or a proxy's domain) is always
# accepted. Only for a proxy that changes Host without X-Forwarded-Host.
# BETTER_AUTH_TRUSTED_ORIGINS=https://notas.ejemplo.com

# AES-256-GCM encryption key for AI credentials and SMTP passwords, at least
# 32 characters. Back it up separately; losing it makes stored secrets unreadable.
# If empty, Grafito generates an installation-specific key.
# GRAFITO_ENCRYPTION_KEY=
# Generated-secret directory; Docker uses the grafito_secrets volume.
# GRAFITO_SECRETS_DIR=.data/secrets
# Previous encryption key during rotation; old data is re-encrypted on use.
# See docs/OPERATIONS.md.
# GRAFITO_ENCRYPTION_KEY_PREVIOUS=

# Per-file upload limit in MB: default 100 with S3, 20 with Postgres.
# GRAFITO_MAX_UPLOAD_MB=100

# Database connections per app instance (plus 5 for sign-ins). With several
# instances (docker compose up -d --scale app=4) they must add up to less than
# Postgres's max_connections (100). See docs/OPERATIONS.md.
# GRAFITO_DB_POOL=15

# Optional Git sync: additional allowed hosts besides github.com/gitlab.com,
# comma-separated, and the sync interval in minutes. See docs/GIT.md.
# GRAFITO_GIT_HOSTS=gitlab.universidad.edu
# GRAFITO_GIT_SYNC_MINUTES=2
# Custom certificate authority PEM mounted in the container.
# NODE_EXTRA_CA_CERTS=/app/certs/ca.pem

# Compose-only Postgres password and backup settings.
# POSTGRES_PASSWORD=
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14

# Office editor is enabled by default. Empty disables it; see docs/OFFICE.md.
# Use docker compose up -d --scale collabora=0 to stop its container.
# With Docker Compose the default is same-origin: the gateway serves the editor
# on Grafito's own address (http://IP:8080 or your proxy's https domain), and
# nothing else is needed. Without Docker (npm run dev), Collabora's address:
# COLLABORA_URL=http://127.0.0.1:9980
# Only for a COLLABORA_URL on an address of its own: the address Grafito is
# opened with (may embed the editor), and true when a proxy serves that
# editor over HTTPS. See docs/OFFICE.md.
# GRAFITO_PUBLIC_ORIGIN=https://notas.ejemplo.com
# COLLABORA_SSL_TERMINATION=false
# COLLABORA_ADMIN_PASSWORD=

# Graph engine (Grafeno). With Docker Compose the grafeno service is used and
# only the token needs to change. Empty GRAFENO_URL turns the graph off; without
# Docker (npm run dev), a local engine: GRAFENO_URL=http://127.0.0.1:7810.
# See docs/GRAPH.md.
# GRAFENO_TOKEN=
# GRAFENO_URL=http://grafeno:7810
# GRAFENO_NAMESPACE_PREFIX=grafito-

# Ollama / LM Studio on this same machine: a "localhost" address in
# Account → AI is called on the host through this name. Empty turns it off.
# GRAFITO_LOCALHOST_ALIAS=host.docker.internal

# Time zone of the server, used for dates in emails (see docs/MAIL.md).
# TZ=America/Lima
