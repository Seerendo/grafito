{
  "name": "grafito",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/launch-guard.mjs && vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && npm run db:migrate",
    "build:dev": "vite build --mode development",
    "start": "node .output/server/index.mjs",
    "preview": "node scripts/launch-guard.mjs && vite preview",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\" && node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "~1.6.30",
    "cmdk": "^1.1.1",
    "html2canvas": "^1.4.1",
    "jose": "6.2.9",
    "jspdf": "^4.2.1",
    "kysely": "^0.28.5",
    "ldapts": "^9.2.0",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "mermaid": "^12.2.0",
    "nitro": "3.0.260610-beta",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "unpdf": "^0.12.1",
    "vaul": "^1.1.2",
    "vite": "^8.2.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}
